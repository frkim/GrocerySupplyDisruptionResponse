# Copy to .env and fill from deployment outputs. Never commit the populated file.
# All Azure access uses DefaultAzureCredential; no keys or client secrets are required.

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-grocery-disruption
AZURE_LOCATION=swedencentral

# Microsoft Foundry / Azure OpenAI
AZURE_AI_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
MODEL_DEPLOYMENT_NAME=gpt-4o
MODEL_MAX_CONCURRENCY=6
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# Cosmos DB
COSMOS_ENDPOINT=
COSMOS_DATABASE=GroceryDisruptionDB

# Azure AI Search
SEARCH_ENDPOINT=
SEARCH_INDEX_NAME=grocery-disruption-knowledge

# Storage
STORAGE_BLOB_ENDPOINT=
KNOWLEDGE_CONTAINER=grocery-knowledge

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
GEN_AI_CONTENT_RECORDING=false

# Feature flags
ENABLE_DELIBERATION=true
ENABLE_FOUNDRY_HOSTED_AGENTS=true
PROVISION_FOUNDRY_AGENTS=true
ENABLE_FOUNDRY_KNOWLEDGE=true

# Foundry hosted agent configuration
FOUNDRY_AGENT_PREFIX=gsdr
FOUNDRY_MAX_TOOL_ROUNDS=4
KNOWLEDGE_CONNECTION_NAME=knowledge-search
KNOWLEDGE_QUERY_TYPE=simple
KNOWLEDGE_TOP_K=5

# Optional MCP extension point
MCP_SERVER_LABEL=
MCP_SERVER_URL=

# Runtime
SELF_BASE_URL=http://127.0.0.1:8000
AGENT_TIMEOUT_SECONDS=180
GATE_TIMEOUT_SECONDS=900
DATA_DIR=
