{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "namePrefix": {
      "value": "${AZURE_NAME_PREFIX=gsdr}"
    },
    "modelDeploymentName": {
      "value": "${MODEL_DEPLOYMENT_NAME=gpt-4o}"
    },
    "modelName": {
      "value": "${CHAT_MODEL_NAME=gpt-4o}"
    },
    "modelVersion": {
      "value": "${CHAT_MODEL_VERSION=2024-11-20}"
    },
    "modelSku": {
      "value": "${CHAT_MODEL_SKU=GlobalStandard}"
    },
    "modelCapacity": {
      "value": "${CHAT_MODEL_CAPACITY=100}"
    },
    "embeddingDeploymentName": {
      "value": "${EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large}"
    },
    "embeddingModelName": {
      "value": "${EMBEDDING_MODEL_NAME=text-embedding-3-large}"
    },
    "embeddingModelVersion": {
      "value": "${EMBEDDING_MODEL_VERSION=1}"
    },
    "embeddingSku": {
      "value": "${EMBEDDING_SKU=Standard}"
    },
    "embeddingCapacity": {
      "value": "${EMBEDDING_MODEL_CAPACITY=50}"
    },
    "searchIndexName": {
      "value": "${SEARCH_INDEX_NAME=grocery-disruption-knowledge}"
    },
    "foundryAgentPrefix": {
      "value": "${FOUNDRY_AGENT_PREFIX=gsdr}"
    },
    "knowledgeConnectionName": {
      "value": "${KNOWLEDGE_CONNECTION_NAME=knowledge-search}"
    }
  }
}
