{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "appName": {
      "value": "${AZURE_CONTAINER_APP_NAME}"
    },
    "containerAppEnvironmentId": {
      "value": "${AZURE_CONTAINER_APPS_ENVIRONMENT_ID}"
    },
    "acrLoginServer": {
      "value": "${AZURE_CONTAINER_REGISTRY_ENDPOINT}"
    },
    "containerImage": {
      "value": "${SERVICE_APP_IMAGE_NAME}"
    },
    "identityId": {
      "value": "${SERVICE_APP_IDENTITY_ID}"
    },
    "identityClientId": {
      "value": "${SERVICE_APP_IDENTITY_CLIENT_ID}"
    },
    "aiProjectEndpoint": {
      "value": "${AZURE_AI_PROJECT_ENDPOINT}"
    },
    "openAiEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT}"
    },
    "modelDeploymentName": {
      "value": "${MODEL_DEPLOYMENT_NAME}"
    },
    "translationModelDeploymentName": {
      "value": "${TRANSLATION_MODEL_DEPLOYMENT_NAME}"
    },
    "embeddingDeploymentName": {
      "value": "${EMBEDDING_DEPLOYMENT_NAME}"
    },
    "cosmosEndpoint": {
      "value": "${COSMOS_ENDPOINT}"
    },
    "cosmosDatabase": {
      "value": "${COSMOS_DATABASE}"
    },
    "searchEndpoint": {
      "value": "${SEARCH_ENDPOINT}"
    },
    "searchIndexName": {
      "value": "${SEARCH_INDEX_NAME}"
    },
    "storageBlobEndpoint": {
      "value": "${STORAGE_BLOB_ENDPOINT}"
    },
    "knowledgeContainer": {
      "value": "${KNOWLEDGE_CONTAINER}"
    },
    "knowledgeConnectionName": {
      "value": "${KNOWLEDGE_CONNECTION_NAME}"
    },
    "foundryAgentPrefix": {
      "value": "${FOUNDRY_AGENT_PREFIX}"
    },
    "appInsightsConnectionString": {
      "value": "${APPLICATIONINSIGHTS_CONNECTION_STRING}"
    }
  }
}
